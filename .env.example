# ==============================================================================
# Interview AI - Environment Variables Configuration
# Copy this file to .env before running: cp .env.example .env
# ==============================================================================

# Backend Port (Default: 3000)
PORT=3000

# MongoDB Connection URI (Uses Docker service hostname 'mongodb')
MONGO_URI=mongodb://mongodb:27017/interview-ai

# Secret key for JWT token generation and verification
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Allowed Frontend URL for CORS (Host browser port)
FRONTEND_URL=http://localhost:5173

# Frontend Vite Build-time API Base URL (Accessed by browser on host machine)
VITE_API_URL=http://localhost:3000
